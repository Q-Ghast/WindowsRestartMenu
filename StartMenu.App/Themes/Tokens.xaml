<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="StartMenu.SearchBackgroundBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="StartMenu.CardBackgroundBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="StartMenu.CardBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="StartMenu.PanelBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="StartMenu.SubtleHoverBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="StartMenu.SubtlePressedBrush" Color="#08FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="StartMenu.SearchBackgroundBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="StartMenu.CardBackgroundBrush" Color="#06000000" />
            <SolidColorBrush x:Key="StartMenu.CardBorderBrush" Color="#12000000" />
            <SolidColorBrush x:Key="StartMenu.PanelBorderBrush" Color="#12000000" />
            <SolidColorBrush x:Key="StartMenu.SubtleHoverBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="StartMenu.SubtlePressedBrush" Color="#06000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="StartMenu.SearchBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="StartMenu.CardBackgroundBrush" Color="#00000000" />
            <SolidColorBrush x:Key="StartMenu.CardBorderBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="StartMenu.PanelBorderBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="StartMenu.SubtleHoverBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="StartMenu.SubtlePressedBrush" Color="#22FFFFFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <SolidColorBrush x:Key="StartMenu.AvatarBrush" Color="#2D6CDF" />

    <x:Double x:Key="StartMenu.SearchHeight">32</x:Double>
    <x:Double x:Key="StartMenu.SearchIconSize">16</x:Double>
    <x:Double x:Key="StartMenu.TileIconSize">36</x:Double>
    <x:Double x:Key="StartMenu.TileRowHeight">76</x:Double>
    <x:Double x:Key="StartMenu.CategoryCardHeight">148</x:Double>
    <x:Double x:Key="StartMenu.CategoryIconSize">32</x:Double>
    <x:Double x:Key="StartMenu.FooterHeight">48</x:Double>
    <x:Double x:Key="StartMenu.AvatarSize">28</x:Double>
    <x:Double x:Key="StartMenu.SectionHeaderFontSize">16</x:Double>
    <x:Double x:Key="StartMenu.BodyFontSize">14</x:Double>
    <x:Double x:Key="StartMenu.CaptionFontSize">12</x:Double>
    <x:Double x:Key="StartMenu.TileLabelHeight">28</x:Double>

    <CornerRadius x:Key="StartMenu.SearchCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="StartMenu.TileCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="StartMenu.CardCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="StartMenu.ButtonCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="StartMenu.AvatarCornerRadius">14</CornerRadius>

    <Thickness x:Key="StartMenu.SearchMargin">24,8,24,0</Thickness>
    <Thickness x:Key="StartMenu.SearchPadding">10,0,12,0</Thickness>
    <Thickness x:Key="StartMenu.ContentMargin">24,16,24,16</Thickness>
    <Thickness x:Key="StartMenu.FooterMargin">24,0,24,8</Thickness>
    <Thickness x:Key="StartMenu.CategoryCardPadding">12</Thickness>
</ResourceDictionary>
