<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:StartMenu_App.Controls"
    xmlns:vm="using:StartMenu_App.ViewModels">

    <Style x:Key="StartMenu.TileButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource StartMenu.ButtonCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="StartMenu.CategoryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource StartMenu.CardCornerRadius}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="StartMenu.HeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource StartMenu.ButtonCornerRadius}" />
        <Setter Property="FontSize" Value="{StaticResource StartMenu.CaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="StartMenu.FooterIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="StartMenu.SearchBorderStyle" TargetType="Border">
        <Setter Property="Height" Value="{StaticResource StartMenu.SearchHeight}" />
        <Setter Property="Background" Value="{ThemeResource StartMenu.SearchBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource StartMenu.SearchCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource StartMenu.SearchPadding}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="StartMenu.CategoryCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource StartMenu.CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource StartMenu.CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource StartMenu.CardCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource StartMenu.CategoryCardPadding}" />
    </Style>

    <Style x:Key="StartMenu.SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.SectionHeaderFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StartMenu.CaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.CaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StartMenu.SearchPlaceholderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StartMenu.FooterNameStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StartMenu.TileLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.CaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineHeight" Value="14" />
        <Setter Property="Height" Value="{StaticResource StartMenu.TileLabelHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <Style x:Key="StartMenu.CardLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.CaptionFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <Style x:Key="StartMenu.AvatarInitialStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.CaptionFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="StartMenu.SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="{StaticResource StartMenu.BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="StartMenu.SearchClearButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="StartMenu.RowButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource StartMenu.ButtonCornerRadius}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <Style x:Key="StartMenu.RowLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.BodyFontSize}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StartMenu.GroupHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource StartMenu.BodyFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <DataTemplate x:Key="StartMenu.AppTileTemplate">
        <Button
            Height="{StaticResource StartMenu.TileRowHeight}"
            AutomationProperties.Name="{Binding DisplayName}"
            Command="{Binding ActivateCommand}"
            Style="{StaticResource StartMenu.TileButtonStyle}"
            ToolTipService.ToolTip="{Binding DisplayName}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="4">
                <Grid
                    Width="{StaticResource StartMenu.TileIconSize}"
                    Height="{StaticResource StartMenu.TileIconSize}">
                    <Border
                        Background="{Binding AccentBrush}"
                        CornerRadius="{StaticResource StartMenu.TileCornerRadius}"
                        Visibility="{Binding FallbackVisibility}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="18"
                            Foreground="White"
                            Glyph="{Binding Glyph}" />
                    </Border>
                    <Image
                        Width="{StaticResource StartMenu.TileIconSize}"
                        Height="{StaticResource StartMenu.TileIconSize}"
                        Source="{Binding IconSource}"
                        Stretch="Uniform"
                        Visibility="{Binding IconVisibility}" />
                </Grid>
                <TextBlock Style="{StaticResource StartMenu.TileLabelStyle}" Text="{Binding DisplayName}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="StartMenu.MiniAppIconTemplate">
        <Grid
            Width="{StaticResource StartMenu.CategoryIconSize}"
            Height="{StaticResource StartMenu.CategoryIconSize}">
            <Border
                Background="{Binding AccentBrush}"
                CornerRadius="7"
                Visibility="{Binding FallbackVisibility}">
                <FontIcon
                    FontFamily="Segoe Fluent Icons"
                    FontSize="16"
                    Foreground="White"
                    Glyph="{Binding Glyph}" />
            </Border>
            <Image
                Width="{StaticResource StartMenu.CategoryIconSize}"
                Height="{StaticResource StartMenu.CategoryIconSize}"
                Source="{Binding IconSource}"
                Stretch="Uniform"
                Visibility="{Binding IconVisibility}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="StartMenu.CategoryCardTemplate">
        <Button
            Height="{StaticResource StartMenu.CategoryCardHeight}"
            AutomationProperties.Name="{Binding DisplayName}"
            Command="{Binding OpenCommand}"
            Style="{StaticResource StartMenu.CategoryButtonStyle}">
            <Border Style="{StaticResource StartMenu.CategoryCardStyle}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        ColumnSpacing="12"
                        RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl
                            Grid.Row="0"
                            Grid.Column="0"
                            Width="{StaticResource StartMenu.CategoryIconSize}"
                            Height="{StaticResource StartMenu.CategoryIconSize}"
                            Content="{Binding Top1}"
                            ContentTemplate="{StaticResource StartMenu.MiniAppIconTemplate}" />
                        <ContentControl
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="{StaticResource StartMenu.CategoryIconSize}"
                            Height="{StaticResource StartMenu.CategoryIconSize}"
                            Content="{Binding Top2}"
                            ContentTemplate="{StaticResource StartMenu.MiniAppIconTemplate}" />
                        <ContentControl
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="{StaticResource StartMenu.CategoryIconSize}"
                            Height="{StaticResource StartMenu.CategoryIconSize}"
                            Content="{Binding Top3}"
                            ContentTemplate="{StaticResource StartMenu.MiniAppIconTemplate}" />
                        <ContentControl
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="{StaticResource StartMenu.CategoryIconSize}"
                            Height="{StaticResource StartMenu.CategoryIconSize}"
                            Content="{Binding Top4}"
                            ContentTemplate="{StaticResource StartMenu.MiniAppIconTemplate}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        Style="{StaticResource StartMenu.CardLabelStyle}"
                        Text="{Binding DisplayName}" />
                </Grid>
            </Border>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="StartMenu.AppTileCompactTemplate">
        <Button
            Height="56"
            AutomationProperties.Name="{Binding DisplayName}"
            Command="{Binding ActivateCommand}"
            Style="{StaticResource StartMenu.TileButtonStyle}"
            ToolTipService.ToolTip="{Binding DisplayName}">
            <Grid
                Width="{StaticResource StartMenu.TileIconSize}"
                Height="{StaticResource StartMenu.TileIconSize}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Border
                    Background="{Binding AccentBrush}"
                    CornerRadius="{StaticResource StartMenu.TileCornerRadius}"
                    Visibility="{Binding FallbackVisibility}">
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="18"
                        Foreground="White"
                        Glyph="{Binding Glyph}" />
                </Border>
                <Image
                    Width="{StaticResource StartMenu.TileIconSize}"
                    Height="{StaticResource StartMenu.TileIconSize}"
                    Source="{Binding IconSource}"
                    Stretch="Uniform"
                    Visibility="{Binding IconVisibility}" />
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="StartMenu.AppRowTemplate">
        <Button
            AutomationProperties.Name="{Binding DisplayName}"
            Command="{Binding ActivateCommand}"
            Style="{StaticResource StartMenu.RowButtonStyle}"
            ToolTipService.ToolTip="{Binding DisplayName}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="{StaticResource StartMenu.CategoryIconSize}"
                    Height="{StaticResource StartMenu.CategoryIconSize}">
                    <Border
                        Background="{Binding AccentBrush}"
                        CornerRadius="7"
                        Visibility="{Binding FallbackVisibility}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="White"
                            Glyph="{Binding Glyph}" />
                    </Border>
                    <Image
                        Width="{StaticResource StartMenu.CategoryIconSize}"
                        Height="{StaticResource StartMenu.CategoryIconSize}"
                        Source="{Binding IconSource}"
                        Stretch="Uniform"
                        Visibility="{Binding IconVisibility}" />
                </Grid>

                <TextBlock
                    Grid.Column="1"
                    Style="{StaticResource StartMenu.RowLabelStyle}"
                    Text="{Binding DisplayName}" />
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="StartMenu.SearchResultTemplate">
        <Button
            AutomationProperties.Name="{Binding DisplayName}"
            Command="{Binding ActivateCommand}"
            Style="{StaticResource StartMenu.RowButtonStyle}"
            ToolTipService.ToolTip="{Binding DisplayName}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid
                    Width="{StaticResource StartMenu.CategoryIconSize}"
                    Height="{StaticResource StartMenu.CategoryIconSize}">
                    <Border
                        Background="{Binding AccentBrush}"
                        CornerRadius="7"
                        Visibility="{Binding FallbackVisibility}">
                        <FontIcon
                            FontFamily="Segoe Fluent Icons"
                            FontSize="16"
                            Foreground="White"
                            Glyph="{Binding Glyph}" />
                    </Border>
                    <Image
                        Width="{StaticResource StartMenu.CategoryIconSize}"
                        Height="{StaticResource StartMenu.CategoryIconSize}"
                        Source="{Binding IconSource}"
                        Stretch="Uniform"
                        Visibility="{Binding IconVisibility}" />
                </Grid>

                <controls:HighlightedTextBlock
                    Grid.Column="1"
                    Query="{Binding SearchQuery}"
                    Text="{Binding DisplayName}" />
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate x:Key="StartMenu.GridAllAppsGroupTemplate">
        <StackPanel
            Margin="0,0,0,16"
            HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource StartMenu.GroupHeaderStyle}" Text="{Binding Header}" />
            <ItemsRepeater
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                ItemTemplate="{StaticResource StartMenu.AppTileTemplate}"
                ItemsSource="{Binding Apps}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsJustification="Start"
                        ItemsStretch="Fill"
                        MinColumnSpacing="8"
                        MinItemHeight="76"
                        MinItemWidth="96"
                        MinRowSpacing="4" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="StartMenu.ListAllAppsGroupTemplate">
        <StackPanel
            Margin="0,0,0,16"
            HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource StartMenu.GroupHeaderStyle}" Text="{Binding Header}" />
            <ItemsRepeater
                Margin="0,4,0,0"
                HorizontalAlignment="Stretch"
                ItemTemplate="{StaticResource StartMenu.AppRowTemplate}"
                ItemsSource="{Binding Apps}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="0" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
